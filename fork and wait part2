#include<stdio.h>
#include<stdlib.h>
#include<unistd.h>

int main()
{
    pid_t pid=fork();

    if(pid==0)
    {
        printf("Child Process\n");
        printf("PID = %d\n",getpid());

        exit(0);
    }

    else
    {
        printf("Parent Process Sleeping...\n");
        sleep(20);

        printf("Parent PID = %d\n",getpid());
    }

    return 0;
}
