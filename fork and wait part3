#include<stdio.h>
#include<stdlib.h>
#include<unistd.h>

int main()
{
    pid_t pid=fork();

    if(pid==0)
    {
        sleep(5);

        printf("Child Process\n");
        printf("Child PID = %d\n",getpid());
        printf("New Parent PID = %d\n",getppid());
    }

    else
    {
        printf("Parent Process Exiting...\n");
        exit(0);
    }

    return 0;
}
