#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <string.h>
#include <sys/wait.h>
#include <fcntl.h>

int main()
{
    int fd1[2], fd2[2];
    pid_t pid;
    char filename[100];
    char buffer[1000];
    int file;

    pipe(fd1);
    pipe(fd2);

    pid = fork();

    if(pid < 0)
    {
        printf("Fork failed\n");
        return 1;
    }

    if(pid > 0)
    {
        // Parent Process
        close(fd1[0]);
        close(fd2[1]);

        printf("Enter file name: ");
        scanf("%99s", filename);

        write(fd1[1], filename, strlen(filename) + 1);
        close(fd1[1]);

        read(fd2[0], buffer, sizeof(buffer));
        close(fd2[0]);

        printf("\nFile Contents:\n%s\n", buffer);

        wait(NULL);
    }
    else
    {
        // Child Process
        close(fd1[1]);
        close(fd2[0]);

        read(fd1[0], filename, sizeof(filename));
        close(fd1[0]);

        file = open(filename, O_RDONLY);

        if(file < 0)
        {
            strcpy(buffer, "Error: File not found.");
        }
        else
        {
            int n = read(file, buffer, sizeof(buffer) - 1);
            buffer[n] = '\0';
            close(file);
        }

        write(fd2[1], buffer, strlen(buffer) + 1);
        close(fd2[1]);

        exit(0);
    }

    return 0;
}
